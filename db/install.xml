<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="filter/algorithm/db" VERSION="20261111" COMMENT="XMLDB file for Moodle filter/algorithm"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="filter_algorithm_work" COMMENT="The last copy of an exercise each student changed, for the class view of the teacher.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="contextid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Context of the page with the exercise."/>
        <FIELD NAME="workkey" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Which exercise of the page (a hash of the starting algorithm and its tests)."/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="The student."/>
        <FIELD NAME="program" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="The student's algorithm (JSON)."/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="When the copy was saved."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="contextid" TYPE="foreign" FIELDS="contextid" REFTABLE="context" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="contextid-workkey-userid" UNIQUE="true" FIELDS="contextid, workkey, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
